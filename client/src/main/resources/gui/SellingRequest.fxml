<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #f7f7f7;" stylesheets="@Stylist.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ClientSellerController">
    <children>
        <Label text="Register Item for Sale">
            <font><Font name="System Bold" size="20.0" /></font>
        </Label>

        <VBox spacing="15.0" styleClass="form-container">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Item Name" style="-fx-font-weight: bold;" />
                        <TextField fx:id="txtProductName" promptText="Ex: iPhone 15 Pro Max" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Starting Price (VND)" style="-fx-font-weight: bold;" />
                        <TextField fx:id="txtStartPrice" promptText="0.00" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Item Image" style="-fx-font-weight: bold;" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Button text="Select Image..." />
                                <Label text="No file selected" textFill="#777" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Detailed Description" style="-fx-font-weight: bold;" />
                        <TextArea fx:id="txtDescription" prefHeight="100.0" promptText="Enter item condition, warranty details, etc..." wrapText="true" />
                    </children>
                </VBox>

                <Separator />

                <Button maxWidth="Infinity" styleClass="button-ebay" text="Submit Request">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #777;" text="Cancel" />
            </children>
        </VBox>
    </children>
    <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
</VBox>