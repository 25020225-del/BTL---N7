<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="auth-root" stylesheets="@index.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.RegisterController">
   <children>
      <VBox alignment="CENTER" layoutX="390.0" layoutY="50.0" prefHeight="620.0" prefWidth="500.0" spacing="20.0" styleClass="auth-card">
         <children>
            <Text styleClass="auth-title" text="REGISTER">
               <font>
                  <Font size="48.0" />
               </font>
            </Text>

            <GridPane vgap="15.0" style="-fx-padding: 0 50 0 50;">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
                  <RowConstraints vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <VBox spacing="5">
                     <Label styleClass="auth-label" text="Full Name" />
                     <TextField fx:id="registerName" styleClass="auth-input" />
                  </VBox>
                  <VBox spacing="5" GridPane.rowIndex="1">
                     <Label styleClass="auth-label" text="Username" />
                     <TextField fx:id="registerAccountName" styleClass="auth-input" />
                  </VBox>
                  <VBox spacing="5" GridPane.rowIndex="2">
                     <Label styleClass="auth-label" text="Password" />
                     <PasswordField fx:id="registerPasswordAccount" styleClass="auth-input" />
                  </VBox>
                  <VBox spacing="5" GridPane.rowIndex="3">
                     <Label styleClass="auth-label" text="Confirm Password" />
                     <PasswordField fx:id="confirmPasswordAccount" styleClass="auth-input" />
                  </VBox>
                  <VBox spacing="5" GridPane.rowIndex="4">
                     <Label styleClass="auth-label" text="Role Selection" />
                     <ComboBox fx:id="registerRole" maxWidth="Infinity" styleClass="auth-input" />
                  </VBox>
               </children>
            </GridPane>

            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#onRegisterButtonClick" prefHeight="45.0" prefWidth="250.0" styleClass="auth-btn-primary" text="CREATE ACCOUNT" />

            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="Already have an account?" style="-fx-text-fill: #666666;" />
                  <Button fx:id="changeLoginScene" mnemonicParsing="false" onAction="#onLoginViewButtonClick" styleClass="auth-link" style="-fx-background-color: transparent;" text="Sign In" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>