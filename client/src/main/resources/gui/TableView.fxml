<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="0" style="-fx-background-color: #f8f9fa;" stylesheets="@Stylist.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Thanh tìm kiếm nâng cấp hiệu ứng đổ bóng & bo góc nhẹ -->
        <HBox fx:id="searchBarContainer" alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <padding>
                <Insets bottom="15" left="25" right="25" top="15" />
            </padding>
            <children>
                <!-- Icon giữ nguyên, chỉnh kích thước to rõ hơn nếu cần -->
                <FontIcon iconColor="#5d606d" iconLiteral="mdi2n-note-search" iconSize="20" selectionEnd="0" />

                <!-- Thanh nhập liệu cao hơn, bo góc mềm mại -->
                <TextField fx:id="searchField" prefHeight="38.0" promptText="Search securities, stocks, or bidders..." style="-fx-background-color: #f1f3f5; -fx-background-radius: 8; -fx-padding: 0 15; -fx-font-size: 14;" styleClass="search-field" HBox.hgrow="ALWAYS" />

                <!-- Nút Search đổi màu xanh công nghệ nổi bật -->
                <Button fx:id="searchButton" mnemonicParsing="false" onAction="#search" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #4e73df; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Search" />
            </children>
        </HBox>
      <HBox fx:id="fillerBarContainer" prefWidth="389.0" style="-fx-background-color: white; -fx-background-radius: 0 0 12 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" />

        <!-- Khu vực cuộn hiển thị lưới sản phẩm -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background-insets: 0;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <content>
                <!-- TilePane chứa các card sản phẩm, tăng khoảng cách hgap/vgap để các card không bị dính vào nhau -->
                <TilePane fx:id="mainTilePane" hgap="20.0" nodeOrientation="LEFT_TO_RIGHT" style="-fx-background-color: transparent;" vgap="20.0" />
            </content>
        </ScrollPane>
    </children>
</VBox>
