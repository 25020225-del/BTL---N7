<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="0" stylesheets="@index.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox fx:id="searchBarContainer" alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="15" left="25" right="25" top="15" />
            </padding>
            <FontIcon iconLiteral="mdi2n-note-search" />
            <TextField fx:id="searchField" promptText="Search securities, stocks, or bidders..." styleClass="search-field" HBox.hgrow="ALWAYS" />
            <Button fx:id="searchButton" mnemonicParsing="false" onAction="#Search" text="Search" />
        </HBox>

        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <content>
                <TilePane fx:id="mainTilePane" hgap="5.0" nodeOrientation="LEFT_TO_RIGHT" vgap="5.0" />
            </content>
        </ScrollPane>
    </children>
</VBox>
