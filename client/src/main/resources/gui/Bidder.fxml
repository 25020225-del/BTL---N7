<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="0" stylesheets="@Stylist.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.BidderController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
            <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
            <Label fx:id="lblUserMenu" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #e53238;" text="BIDDER" />
            <TextField promptText="Tìm kiếm bất cứ thứ gì..." style="-fx-background-radius: 20; -fx-padding: 8 15;" styleClass="search-field" stylesheets="@Stylist.css" HBox.hgrow="ALWAYS" />
        </HBox>

        <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: #f7f7f7;" VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="productContainer" alignment="TOP_CENTER" hgap="20.0" style="-fx-background-color: #f7f7f7;" vgap="20.0">
                    <padding><Insets bottom="30" left="20" right="20" top="30" /></padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>
