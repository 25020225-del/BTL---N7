<?xml version="1.0" encoding="UTF-8"?>

<!--
  FILE: client/src/main/resources/gui/widget/BidPanel.fxml

  CHANGES vs previous version:
    • txtBidAmount     → txtManualBid     (matches @FXML field in BidPanelController)
    • circleStatus     → dotBotStatus     (matches @FXML field)
    • txtMaxBudget     → txtAutoMax       (matches @FXML field)
    • txtIncrement     → txtAutoIncrement (matches @FXML field)
    • lblAutoBidError  → lblAutoError     (matches @FXML field)
    • Single btnToggleAutoBid replaced by btnSaveAuto + btnCancelAuto:
        - btnCancelAuto starts hidden (managed=false); syncAuctionState() toggles visibility.
        - Visibility is controlled programmatically — no onAction in FXML for cancel.
    • lblManualError and lblAutoError start invisible/unmanaged; shown only on validation failure.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<TabPane
        fx:id="tabPane"
        tabClosingPolicy="UNAVAILABLE"
        styleClass="bid-panel"
        stylesheets="@bid-panel.css"
        xmlns:fx="http://javafx.com/fxml/1"
        xmlns="http://javafx.com/javafx/17"
        fx:controller="gui.widget.BidPanelController"
>

    <!-- ══════════════════════════════════════════════════════════════════════
         Tab 1 — Manual Bid
         ══════════════════════════════════════════════════════════════════════ -->
    <Tab text="Đặt giá thủ công" fx:id="tabManual">
        <content>
            <VBox spacing="12" styleClass="tab-content">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <!-- Minimum-bid hint — prompt text updated by syncAuctionState() -->
                <Label fx:id="lblMinBidHint"
                       text="Giá tối thiểu: —"
                       styleClass="hint-label"/>

                <!-- Bid amount input -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <!--
                        fx:id FIXED: was "txtBidAmount", must match
                        @FXML private TextField txtManualBid in BidPanelController
                    -->
                    <TextField fx:id="txtManualBid"
                               promptText="Nhập số tiền (VNĐ)"
                               styleClass="bid-input"
                               HBox.hgrow="ALWAYS"/>
                    <Label text="VNĐ" styleClass="unit-label"/>
                </HBox>

                <!-- Validation message — hidden until showManualError() is called -->
                <Label fx:id="lblManualError"
                       text=""
                       styleClass="error-label"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

                <!-- Place Bid button -->
                <Button fx:id="btnPlaceBid"
                        text="Đặt Giá"
                        styleClass="primary-button"
                        maxWidth="Infinity"/>
            </VBox>
        </content>
    </Tab>

    <!-- ══════════════════════════════════════════════════════════════════════
         Tab 2 — Auto-Bid
         ══════════════════════════════════════════════════════════════════════ -->
    <Tab text="Tự động đấu giá (AutoBid)" fx:id="tabAutoBid">
        <content>
            <VBox spacing="12" styleClass="tab-content">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <!-- Status row: signal dot + label -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <!--
                        fx:id FIXED: was "circleStatus", must match
                        @FXML private Circle dotBotStatus in BidPanelController
                    -->
                    <Circle fx:id="dotBotStatus"
                            radius="7"
                            styleClass="status-dot-inactive"/>
                    <Label fx:id="lblAutoBidStatus"
                           text="Chưa kích hoạt"
                           styleClass="status-label"/>
                </HBox>

                <Separator/>

                <!-- Max budget input -->
                <VBox spacing="4">
                    <Label text="Ngân sách tối đa (VNĐ)" styleClass="field-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <!--
                            fx:id FIXED: was "txtMaxBudget", must match
                            @FXML private TextField txtAutoMax in BidPanelController
                        -->
                        <TextField fx:id="txtAutoMax"
                                   promptText="Ví dụ: 5,000,000"
                                   styleClass="bid-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Label text="VNĐ" styleClass="unit-label"/>
                    </HBox>
                </VBox>

                <!-- Increment input -->
                <VBox spacing="4">
                    <Label text="Bước tăng mỗi lần (VNĐ)" styleClass="field-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <!--
                            fx:id FIXED: was "txtIncrement", must match
                            @FXML private TextField txtAutoIncrement in BidPanelController
                        -->
                        <TextField fx:id="txtAutoIncrement"
                                   promptText="Ví dụ: 100,000"
                                   styleClass="bid-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Label text="VNĐ" styleClass="unit-label"/>
                    </HBox>
                </VBox>

                <!-- Validation message — hidden until showAutoError() is called -->
                <!--
                    fx:id FIXED: was "lblAutoBidError", must match
                    @FXML private Label lblAutoError in BidPanelController
                -->
                <Label fx:id="lblAutoError"
                       text=""
                       styleClass="error-label"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

                <!--
                    STRUCTURAL FIX: replaced single toggle button with two explicit buttons.

                    Previous single "btnToggleAutoBid" required the controller to swap its
                    label text and handler on every state change — fragile and hard to style.

                    Now:
                      • btnSaveAuto   — visible when no auto-bid is active   (default)
                      • btnCancelAuto — visible when an active auto-bid exists (starts hidden)
                    syncAuctionState() flips visibility/managed on each auction update.
                -->
                <Button fx:id="btnSaveAuto"
                        text="Kích hoạt AutoBid"
                        styleClass="primary-button"
                        maxWidth="Infinity"/>

                <Button fx:id="btnCancelAuto"
                        text="Huỷ AutoBid"
                        styleClass="danger-button"
                        maxWidth="Infinity"
                        visible="false"
                        managed="false"/>

                <!-- Footer hint -->
                <Label text="Hệ thống sẽ tự động đặt giá thay bạn, tối đa đến ngưỡng trên."
                       styleClass="footer-hint"
                       wrapText="true"/>
            </VBox>
        </content>
    </Tab>

</TabPane>
