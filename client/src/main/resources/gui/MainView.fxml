<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox prefHeight="720.0" prefWidth="1280.0" styleClass="main-view-root" stylesheets="@index.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MainController">
   <children>
      <VBox fx:id="mainDock" prefWidth="80.0" alignment="TOP_CENTER" spacing="20.0">
         <children>
            <Region VBox.vgrow="ALWAYS" />
         </children>
      </VBox>

      <VBox fx:id="mainViewController" spacing="20.0" HBox.hgrow="ALWAYS">
         <padding>
            <javafx.geometry.Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="top-search-bar">
               <children>
                  <FontIcon iconLiteral="mdi2n-note-search" iconSize="30" fill="#e74c3c" />
                  <TextField fx:id="searchField" promptText="Search stocks..." HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;" />
                  <Button fx:id="searchButton" text="SEARCH" />
               </children>
            </HBox>

            <ScrollPane fx:id="mainTableVIew" fitToHeight="true" fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
               <content>
                  <TilePane fx:id="mainTilePane" style="-fx-background-color: transparent;" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</HBox>