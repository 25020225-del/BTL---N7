<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox prefHeight="720.0" prefWidth="1280.0" styleClass="main-view-root" stylesheets="@index.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="gui.MainController">
   <children>
      <VBox fx:id="mainDock" alignment="TOP_CENTER" spacing="20.0">
         <children>
            <Region VBox.vgrow="ALWAYS" />
            <Button mnemonicParsing="false" text="Button" />
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>

      <VBox fx:id="mainViewController" spacing="20.0" HBox.hgrow="ALWAYS">
         <padding>
            <javafx.geometry.Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="top-search-bar">
               <children>
                  <FontIcon fill="#e74c3c" iconLiteral="mdi2n-note-search" iconSize="30" />
                  <TextField fx:id="searchField" promptText="Search stocks..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                  <Button fx:id="searchButton" text="SEARCH" />
               </children>
            </HBox>

            <ScrollPane fx:id="mainTableVIew" fitToHeight="true" fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
               <content>
                  <TilePane fx:id="mainTilePane" style="-fx-background-color: transparent;" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</HBox>
