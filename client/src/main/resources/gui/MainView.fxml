<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<HBox prefHeight="720.0" prefWidth="1280.0" spacing="10.0" stylesheets="@index.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MainController">
   <children>
      <VBox fx:id="mainDock" spacing="20.0" styleClass="side-bar-dock">
         <children>
            <Region VBox.vgrow="ALWAYS" />
            <Button mnemonicParsing="false" text="Button" />
         </children>
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
      </VBox>

            <VBox fx:id="mainViewController" prefHeight="680.0" prefWidth="1150.0" spacing="25.0" HBox.hgrow="ALWAYS">
         <children>
            <HBox spacing="10.0">
               <children>
                  <FontIcon iconLiteral="mdi2n-note-search" styleClass="auth-icon" wrappingWidth="21.5" />

                              <TextField fx:id="searchField" prefHeight="45.0" promptText="Search securities, stocks, or bidders..." styleClass="search-input-main" HBox.hgrow="ALWAYS" />

                              <Button fx:id="searchButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="110.0" styleClass="btn-search-red" text="SEARCH" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>

                  <ScrollPane fx:id="mainTableVIew" fitToHeight="true" fitToWidth="true" styleClass="main-scroll-pane" VBox.vgrow="ALWAYS">
               <content>
                  <TilePane fx:id="mainTilePane" styleClass="main-tile-pane" />
               </content>
            </ScrollPane>

               </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</HBox>
