<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<VBox prefHeight="720.0" prefWidth="1280.0" stylesheets="@index.css" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER" prefWidth="200.0" spacing="20.0">
            <padding>
                <Insets left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <ImageView fitHeight="57.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/logo2.png"/>
                    </image>
                </ImageView>
                <Text fill="#36555c" fontSmoothingType="LCD" strokeType="OUTSIDE" strokeWidth="0.0"
                      text="ONLINE AUCTION SERVICE">
                    <font>
                        <Font name="System Bold" size="39.0"/>
                    </font>
                </Text>
            </children>
        </HBox>
        <HBox spacing="10.0" stylesheets="@index.css" VBox.vgrow="ALWAYS">
            <children>
                <VBox fx:id="mainDock" alignment="TOP_CENTER" maxWidth="-Infinity" minWidth="-Infinity" spacing="20.0"
                      styleClass="side-bar-dock">
                    <padding>
                        <Insets bottom="20.0" left="10.0" right="10.0" top="20.0"/>
                    </padding>
                    <HBox.margin>
                        <Insets/>
                    </HBox.margin>
                </VBox>

                <VBox fx:id="mainViewController" prefHeight="680.0" prefWidth="1150.0" spacing="15.0"
                      HBox.hgrow="ALWAYS"/>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </HBox>
    </children>
</VBox>
