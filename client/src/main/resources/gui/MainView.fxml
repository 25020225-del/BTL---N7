<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<HBox prefHeight="720.0" prefWidth="1280.0" spacing="20.0" stylesheets="@index.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MainController">
   <children>
      <VBox fx:id="mainDock" spacing="15.0" style="-fx-background-radius: 10; -fx-border-color: #909090; -fx-border-radius: 10; -fx-border-style: solid;" HBox.hgrow="ALWAYS">
         <children>
            <Region VBox.vgrow="ALWAYS" />
            <Button mnemonicParsing="false" VBox.vgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
      <VBox fx:id="mainViewController" spacing="15.0" HBox.hgrow="ALWAYS">
         <children>
            <HBox spacing="10.0" style="-fx-border-style: solid; -fx-border-color: #909090; -fx-border-radius: 10;">
               <children>
                  <FontIcon iconLiteral="mdi2n-note-search" iconSize="46" />
                  <TextField fx:id="searchField" prefHeight="49.0" prefWidth="825.0" stylesheets="@index.css" HBox.hgrow="ALWAYS" />
                  <Button fx:id="searchButton" mnemonicParsing="false" stylesheets="@index.css" text="Search" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
            <ScrollPane fx:id="mainTableVIew" fitToHeight="true" fitToWidth="true" style="-fx-border-color: transparent; -fx-border-width: 0; -fx-focus-traversable: white;" VBox.vgrow="ALWAYS">
               <content>
                  <TilePane hgap="20.0" prefTileWidth="260.0" style="-fx-border-color: transparent;" vgap="20.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</HBox>
