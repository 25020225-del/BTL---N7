<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="450.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ItemDetailController">
    <children>
        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <children>
                <VBox spacing="5.0" style="-fx-background-color: #f8f8f8; -fx-padding: 10;">
                    <children>
                    </children>
                </VBox>

                <Label fx:id="lblTimeLeft" styleClass="timer-text" text="Remaining time: 00:00:00" />
                <TextArea fx:id="txtDescription" prefHeight="100.0" wrapText="true" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</HBox>