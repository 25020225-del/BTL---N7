<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefWidth="200.0" spacing="10.0"
      style="-fx-border-color: #dddddd; -fx-border-radius: 10; -fx-background-color: white;" styleClass="product-card"
      stylesheets="@Stylist.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fx:id="imgProduct" fitHeight="150.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true"/>
        <VBox spacing="5.0">
            <children>
                <Label fx:id="lblTitle" style="-fx-font-weight: bold;" text="Sample Item" wrapText="true"/>
                <Label fx:id="lblPrice" style="-fx-text-fill: #e53238; -fx-font-size: 16;" styleClass="price-text"
                       stylesheets="@Stylist.css" text="\$100.00"/>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        style="-fx-background-color: #3665f3; -fx-text-fill: white;" styleClass="button-ebay"
                        text="Place Bid"/>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0"/>
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets top="10.0"/>
    </padding>
</VBox>