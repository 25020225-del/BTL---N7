<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@Stylist.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ClientBidderController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #e5e5e5; -fx-border-width: 0 0 1 0;">
            <children>
                <Label text="BIDDER" textFill="#3665f3">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Translated search placeholder -->
                <TextField prefWidth="350.0" promptText="Search items..." styleClass="search-field" />

                <Region HBox.hgrow="ALWAYS" />

                <Button mnemonicParsing="false" styleClass="button-sell" text="Sell" />

                <Label fx:id="lblUserMenu" style="-fx-cursor: hand;" text="My Account ▼" />
            </children>
            <padding><Insets left="20.0" right="20.0" /></padding>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <FlowPane fx:id="productContainer" hgap="20.0" vgap="20.0" style="-fx-padding: 20;" />
            </content>
        </ScrollPane>
    </center>
</BorderPane>