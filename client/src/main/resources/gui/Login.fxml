<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="gui.LoginController"
           prefWidth="420" prefHeight="560"
           style="-fx-background-color: #1a1a2e;">

    <VBox fx:id="loginPane"
          visible="true" managed="true"
          alignment="CENTER" spacing="14"
          style="-fx-background-color: #16213e; -fx-background-radius: 16; -fx-padding: 40;">
        <StackPane.margin>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </StackPane.margin>

        <Circle fx:id="myava1" radius="48"
                fill="#0f3460" stroke="#e94560" strokeWidth="3"/>

        <Label text="ĐĂNG NHẬP"
               style="-fx-text-fill: #e94560; -fx-font-size: 22px; -fx-font-weight: bold;"/>

        <TextField fx:id="loginAccountName"
                   promptText="Tên đăng nhập"
                   style="-fx-background-color: #0f3460; -fx-text-fill: white;
                          -fx-prompt-text-fill: #8888aa; -fx-background-radius: 8;
                          -fx-padding: 10 14; -fx-font-size: 14px;"
                   maxWidth="300"/>

        <PasswordField fx:id="loginPasswordAccount"
                       promptText="Mật khẩu"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;
                              -fx-prompt-text-fill: #8888aa; -fx-background-radius: 8;
                              -fx-padding: 10 14; -fx-font-size: 14px;"
                       maxWidth="300"/>

        <Button fx:id="loginButton"
                text="ĐĂNG NHẬP"
                onAction="#onMainViewButtonClick"
                maxWidth="300"
                style="-fx-background-color: #e94560; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 14px;
                       -fx-background-radius: 8; -fx-padding: 12;
                       -fx-cursor: hand;"/>

        <Hyperlink fx:id="forgotPasswordLink"
                   text="Quên mật khẩu?"
                   onAction="#onForgotPasswordClick"
                   style="-fx-text-fill: #8888bb; -fx-font-size: 12px;
                          -fx-border-color: transparent;"/>

        <Separator style="-fx-background-color: #2a2a4a;" maxWidth="300"/>

        <Button text="TẠO TÀI KHOẢN"
                onAction="#onRegisterViewButtonClick"
                maxWidth="300"
                style="-fx-background-color: transparent; -fx-text-fill: #e94560;
                       -fx-border-color: #e94560; -fx-border-radius: 8;
                       -fx-background-radius: 8; -fx-font-size: 13px;
                       -fx-padding: 10; -fx-cursor: hand;"/>
    </VBox>

    <!-- ═══════════════════════════════════════════════════
         PANE 2: Forgot Password — Step 1 (TOTP Verification)
         ═══════════════════════════════════════════════════ -->
    <VBox fx:id="forgotTotpPane"
          visible="false" managed="false"
          alignment="CENTER" spacing="14"
          style="-fx-background-color: #16213e; -fx-background-radius: 16; -fx-padding: 40;">
        <StackPane.margin>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </StackPane.margin>

        <Label text="🔐 QUÊN MẬT KHẨU"
               style="-fx-text-fill: #e94560; -fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label text="Bước 1/2: Xác thực danh tính qua TOTP"
               wrapText="true" maxWidth="300" textAlignment="CENTER"
               style="-fx-text-fill: #aaaacc; -fx-font-size: 12px;"/>

        <Separator style="-fx-background-color: #2a2a4a;" maxWidth="300"/>

        <Label text="Tên đăng nhập" maxWidth="300" alignment="CENTER_LEFT"
               style="-fx-text-fill: #ccccee; -fx-font-size: 12px;"/>
        <TextField fx:id="resetIdentifierField"
                   promptText="Nhập tên đăng nhập của bạn"
                   style="-fx-background-color: #0f3460; -fx-text-fill: white;
                          -fx-prompt-text-fill: #8888aa; -fx-background-radius: 8;
                          -fx-padding: 10 14; -fx-font-size: 14px;"
                   maxWidth="300"/>

        <Label text="Mã TOTP (6 số từ Authenticator)" maxWidth="300" alignment="CENTER_LEFT"
               style="-fx-text-fill: #ccccee; -fx-font-size: 12px;"/>
        <TextField fx:id="resetTotpCodeField"
                   promptText="Ví dụ: 123456"
                   style="-fx-background-color: #0f3460; -fx-text-fill: white;
                          -fx-prompt-text-fill: #8888aa; -fx-background-radius: 8;
                          -fx-padding: 10 14; -fx-font-size: 18px; -fx-alignment: center;"
                   maxWidth="300"/>

        <!-- Inline error label -->
        <Label fx:id="totpResetErrorLabel"
               text="" wrapText="true" maxWidth="300" textAlignment="CENTER"
               style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;"/>

        <Button fx:id="verifyTotpResetButton"
                text="XÁC THỰC"
                onAction="#onVerifyTotpForReset"
                maxWidth="300"
                style="-fx-background-color: #e94560; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 14px;
                       -fx-background-radius: 8; -fx-padding: 12;
                       -fx-cursor: hand;"/>

        <Button fx:id="backToLoginBtn1"
                text="← Quay lại đăng nhập"
                onAction="#onBackToLoginFromStep1"
                maxWidth="300"
                style="-fx-background-color: transparent; -fx-text-fill: #8888bb;
                       -fx-font-size: 12px; -fx-cursor: hand;
                       -fx-border-color: transparent;"/>
    </VBox>

    <!-- ═══════════════════════════════════════════════════
         PANE 3: Forgot Password — Step 2 (New Password)
         ═══════════════════════════════════════════════════ -->
    <VBox fx:id="newPasswordPane"
          visible="false" managed="false"
          alignment="CENTER" spacing="14"
          style="-fx-background-color: #16213e; -fx-background-radius: 16; -fx-padding: 40;">
        <StackPane.margin>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </StackPane.margin>

        <Label text="🔑 ĐẶT LẠI MẬT KHẨU"
               style="-fx-text-fill: #e94560; -fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label text="Bước 2/2: Tạo mật khẩu mới" maxWidth="300" textAlignment="CENTER"
               wrapText="true"
               style="-fx-text-fill: #aaaacc; -fx-font-size: 12px;"/>

        <Label text="✔  Ít nhất 8 ký tự  ·  1 chữ hoa  ·  1 số  ·  1 ký tự đặc biệt"
               wrapText="true" maxWidth="300" textAlignment="CENTER"
               style="-fx-text-fill: #6688aa; -fx-font-size: 11px;"/>

        <Separator style="-fx-background-color: #2a2a4a;" maxWidth="300"/>

        <Label text="Mật khẩu mới" maxWidth="300"
               style="-fx-text-fill: #ccccee; -fx-font-size: 12px;"/>
        <PasswordField fx:id="newPasswordField"
                       promptText="Nhập mật khẩu mới"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;
                              -fx-prompt-text-fill: #8888aa; -fx-background-radius: 8;
                              -fx-padding: 10 14; -fx-font-size: 14px;"
                       maxWidth="300"/>

        <Label text="Xác nhận mật khẩu mới" maxWidth="300"
               style="-fx-text-fill: #ccccee; -fx-font-size: 12px;"/>
        <PasswordField fx:id="confirmNewPasswordField"
                       promptText="Nhập lại mật khẩu mới"
                       style="-fx-background-color: #0f3460; -fx-text-fill: white;
                              -fx-prompt-text-fill: #8888aa; -fx-background-radius: 8;
                              -fx-padding: 10 14; -fx-font-size: 14px;"
                       maxWidth="300"/>

        <!-- Inline error label -->
        <Label fx:id="newPasswordErrorLabel"
               text="" wrapText="true" maxWidth="300" textAlignment="CENTER"
               style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;"/>

        <Button fx:id="resetPasswordButton"
                text="ĐẶT LẠI MẬT KHẨU"
                onAction="#onResetPassword"
                maxWidth="300"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 14px;
                       -fx-background-radius: 8; -fx-padding: 12;
                       -fx-cursor: hand;"/>

        <Button fx:id="backToLoginBtn2"
                text="← Quay lại đăng nhập"
                onAction="#onBackToLoginFromStep2"
                maxWidth="300"
                style="-fx-background-color: transparent; -fx-text-fill: #8888bb;
                       -fx-font-size: 12px; -fx-cursor: hand;
                       -fx-border-color: transparent;"/>
    </VBox>

</StackPane>
