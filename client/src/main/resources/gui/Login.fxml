<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="auth-root" stylesheets="@index.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.LoginController">
   <children>
      <VBox alignment="CENTER" layoutX="415.0" layoutY="100.0" prefHeight="520.0" prefWidth="450.0" spacing="30.0" styleClass="auth-card" AnchorPane.bottomAnchor="100.0" AnchorPane.topAnchor="100.0">
         <children>
            <Text styleClass="auth-title" text="LOGIN">
               <font>
                  <Font size="64.0" />
               </font>
            </Text>

            <VBox spacing="20.0" style="-fx-padding: 0 40 0 40;">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="auth-label" text="Username" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <FontIcon iconLiteral="mdi2a-account" iconSize="25" styleClass="auth-icon" />
                              <TextField fx:id="loginAccountName" promptText="Enter username" styleClass="auth-input" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="auth-label" text="Password" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <FontIcon iconLiteral="mdi2a-account-key" iconSize="25" styleClass="auth-icon" />
                              <PasswordField fx:id="loginPasswordAccount" promptText="Enter password" styleClass="auth-input" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>

            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#onMainViewButtonClick" prefHeight="45.0" prefWidth="200.0" styleClass="auth-btn-primary" text="LOGIN SYSTEM" />

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label text="No account?" style="-fx-text-fill: #666666;" />
                  <Button mnemonicParsing="false" onAction="#onRegisterViewButtonClick" styleClass="auth-link" style="-fx-background-color: transparent;" text="Register Now" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>