<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@Stylist.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ClientAdminController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #e5e5e5; -fx-border-width: 0 0 1 0;">
            <children>
                <Label text="MAIN VIEW" textFill="#3665f3">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label style="-fx-background-color: #333; -fx-text-fill: white; -fx-padding: 2 8; -fx-background-radius: 4;" text="ADMIN" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField prefWidth="300.0" promptText="Tìm kiếm hệ thống..." styleClass="search-field" />
                <Label fx:id="lblAdminMenu" style="-fx-cursor: hand;" text="Admin Account ▼">
                    <font>
                        <Font name="System Semibold" size="14.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <VBox spacing="20.0">
            <children>
                <HBox spacing="15.0">
                    <children>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Tổng sản phẩm" textFill="#777" />
                                <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="177013" />
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Đang đấu giá" textFill="#777" />
                                <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #3665f3;" text="67" />
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Người dùng mới" textFill="#777" />
                                <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="+67" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="10.0" styleClass="product-card" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Quản lý danh sách đấu giá">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button styleClass="button-ebay" text="+ Thêm sản phẩm" />
                            </children>
                        </HBox>

                        <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                                <TableColumn fx:id="colName" prefWidth="250.0" text="Tên sản phẩm" />
                                <TableColumn fx:id="colSeller" prefWidth="120.0" text="Người bán" />
                                <TableColumn fx:id="colPrice" prefWidth="120.0" text="Giá hiện tại" />
                                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Trạng thái" />
                                <TableColumn fx:id="colAction" prefWidth="150.0" text="Thao tác" />
                            </columns>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                </VBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
