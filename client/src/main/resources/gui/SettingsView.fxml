<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10;" stylesheets="@Stylist.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Button mnemonicParsing="false" onAction="#handleBackToMarketplace" styleClass="button-ebay" text="&lt;- Back to Marketplace" />

        <Label text="App Settings">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
            <style>
                -fx-text-fill: #3665f3;
            </style>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Label>

        <Label style="-fx-font-size: 16px;" text="• Notifications: Enabled" />
        <Label style="-fx-font-size: 16px;" text="• Display Theme: Light Mode" />

        <Region VBox.vgrow="ALWAYS" />

        <Button mnemonicParsing="false" onAction="#handleSignOut" style="-fx-background-color: #dd1e31; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 5;" text="SIGN OUT" />
    </children>
</VBox>