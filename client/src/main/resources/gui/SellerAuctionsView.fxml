<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>

<StackPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f8f9fa;"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.SellerAuctionsController">
    <children>
        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Text text="DANH SÁCH SẢN PHẨM ĐANG ĐĂNG BÁN" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
                                <Text text="Chọn một sản phẩm để xem chi tiết biểu đồ đặt giá hoặc điều chỉnh thời gian" style="-fx-fill: #777;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <TableView fx:id="tableSellerAuctions" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="colAuctionId" prefWidth="100.0" text="Mã Phiên" />
                        <TableColumn fx:id="colItemName" prefWidth="350.0" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="colStartPrice" prefWidth="150.0" text="Giá Khởi Điểm" />
                        <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Giá Hiện Tại" />
                        <TableColumn fx:id="colTimeRemaining" prefWidth="200.0" text="Thời Gian Còn Lại" />
                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Trạng Thái" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="btnViewDetails" onAction="#handleViewDetails" prefHeight="40.0" prefWidth="180.0"
                                style="-fx-background-color: #3665f3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="XEM CHI TIẾT PHIÊN →"/>
                    </children>
                </HBox>
            </children>
            <StackPane.margin><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></StackPane.margin>
            <effect><DropShadow color="0x00000022" radius="15" /></effect>
        </VBox>
    </children>
</StackPane>